{
  "name": "case-closed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pull": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/pull-templates.ts",
    "classify": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/classify-templates.ts",
    "aggregate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/aggregate.ts",
    "pipeline": "npm run pull && npm run classify && npm run aggregate",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
