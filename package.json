    "test": "vitest run",
    "warm": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/warm-demo.ts",
    "boroughs": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/pull-boroughs.ts",
    "boomerang": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/boomerang.ts",
