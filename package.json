    "boards": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/pull-boards.ts",
    "years": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/pull-years.ts",
    "audit": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/audit-labels.ts"
